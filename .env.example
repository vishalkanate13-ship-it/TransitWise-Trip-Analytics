# Local Windows MySQL Server (installed directly, no Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=PUT_YOUR_MYSQL_ROOT_PASSWORD_HERE
MYSQL_DATABASE=transit_db

# Local MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=transit_analytics

# Replace with a long random value before deployment
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

NEXT_PUBLIC_APP_NAME=TransitWise
